---
layout: null
permalink: /search.json
sitemap: false
---
{%- comment -%}
  Search index, built once per language : /search.json and /fr/search.json.
  It is read by assets/js/search.js ; there is nothing to update by hand.
{%- endcomment -%}
{% capture titleKey %}title_{{ site.active_lang }}{% endcapture %}
[
{%- for post in site.posts -%}
{
"title": {{ post[titleKey] | default: post.title | jsonify }},
"url": {{ post.url | jsonify }},
"section": {{ post.categories | first | jsonify }},
"image": {{ post.image | jsonify }},
"imageAlt": {{ post.imageAlt | jsonify }},
"date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
"excerpt": {{ post.excerpt | strip_html | normalize_whitespace | strip | jsonify }},
"text": {{ post.content | strip_html | normalize_whitespace | truncatewords: 150 | jsonify }}
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
